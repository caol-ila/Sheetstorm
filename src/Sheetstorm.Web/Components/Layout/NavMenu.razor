<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/" data-testid="brand">Sheetstorm</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Start
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Bands" data-testid="nav-bands">
                        <span class="bi bi-people-fill" aria-hidden="true"></span> Vereine
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Profile" data-testid="nav-profile">
                        <span class="bi bi-person-circle" aria-hidden="true"></span> Profil
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link btn btn-link" data-testid="logout-button">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Abmelden
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register" data-testid="nav-register">
                        <span class="bi bi-person-plus" aria-hidden="true"></span> Registrieren
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login" data-testid="nav-login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Anmelden
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
