@page "/Account/ResetPassword"
@layout MainLayout
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Sheetstorm.Infrastructure.Persistence

<PageTitle>Passwort zurücksetzen — Sheetstorm</PageTitle>

<h1>Passwort zurücksetzen</h1>

@if (done)
{
    <div class="ss-card" data-testid="reset-done">
        <p>Dein Passwort wurde geändert. <a href="/Account/Login">Jetzt anmelden →</a></p>
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger" data-testid="reset-error">@errorMessage</div>
}
else
{
    <div class="ss-card">
        <EditForm Model="Input" OnValidSubmit="ResetAsync" FormName="reset-pw">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText type="password" id="Input.NewPassword" @bind-Value="Input!.NewPassword" data-testid="reset-new" class="form-control" placeholder="Neues Passwort" />
                <label for="Input.NewPassword">Neues Passwort</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" id="Input.ConfirmPassword" @bind-Value="Input.ConfirmPassword" data-testid="reset-confirm" class="form-control" placeholder="Bestätigen" />
                <label for="Input.ConfirmPassword">Bestätigen</label>
            </div>
            <button type="submit" class="ss-btn ss-btn-primary" data-testid="reset-submit">Passwort setzen</button>
        </EditForm>
    </div>
}

@code {
    private bool done;
    private string? errorMessage;

    [SupplyParameterFromQuery] private string? Code { get; set; }
    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
        if (string.IsNullOrEmpty(Code) || string.IsNullOrEmpty(UserId))
        {
            errorMessage = "Reset-Link ist ungültig oder unvollständig.";
        }
    }

    private async Task ResetAsync()
    {
        if (Input is null || string.IsNullOrEmpty(Code) || string.IsNullOrEmpty(UserId)) return;
        if (Input.NewPassword != Input.ConfirmPassword)
        {
            errorMessage = "Passwörter stimmen nicht überein.";
            return;
        }
        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null) { errorMessage = "Benutzer nicht gefunden."; return; }

        try
        {
            var token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var r = await UserManager.ResetPasswordAsync(user, token, Input.NewPassword);
            if (r.Succeeded) done = true;
            else errorMessage = string.Join(", ", r.Errors.Select(e => e.Description));
        }
        catch
        {
            errorMessage = "Reset-Link ist ungültig.";
        }
    }

    private sealed class InputModel
    {
        [Required, StringLength(100, MinimumLength = 4)] public string NewPassword { get; set; } = "";
        [Required] public string ConfirmPassword { get; set; } = "";
    }
}
