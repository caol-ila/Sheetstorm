@inject IJSRuntime JS
@inject HttpClient? Http
@rendermode InteractiveServer

@* Conductor-BLE-Steuerung. Erzeugt lokal ein Keypair, registriert
   Public-Key beim Backend, faengt mit Advertising an.
   Hinweis: Native-Advertising (Peripheral) braucht den Capacitor-Wrapper —
   im reinen Web-Browser ist das aktuell nicht moeglich. Wir zeigen dem
   Dirigenten dann eine entsprechende Hinweis-Box. *@

<div class="ss-card" data-testid="ble-conductor-panel">
    <h3 class="mt-0">📡 BLE-Sync (Pilot)</h3>
    <p class="text-muted small">
        Mit BLE können verbundene Mitglieder live deinen aktuellen Notenstand und Click empfangen.
        Funktioniert am besten in der nativen App; im Browser ist nur das Verifizieren der Schedule
        eines anderen Conductors möglich.
    </p>

    <div class="d-flex gap-2 align-items-center">
        <button type="button" class="ss-btn ss-btn-primary" @onclick="StartAsync" data-testid="ble-start" disabled="@busy">
            @(running ? "🔄 Aktiv" : "▶ BLE starten")
        </button>
        <button type="button" class="ss-btn ss-btn-secondary" @onclick="StopAsync" data-testid="ble-stop" disabled="@(!running)">
            ⏹ Stoppen
        </button>
        @if (!string.IsNullOrEmpty(status))
        {
            <span class="badge bg-info text-dark" data-testid="ble-status">@status</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(publicKey))
    {
        <div class="mt-3" data-testid="ble-key-info">
            <div class="text-muted small">Public-Key (an Mitglieder verteilt):</div>
            <code class="small text-break">@publicKey</code>
        </div>
    }
    @if (!string.IsNullOrEmpty(warning))
    {
        <div class="alert alert-warning mt-2" data-testid="ble-warning">@warning</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid EventId { get; set; }

    private bool running;
    private bool busy;
    private string? publicKey;
    private string? privateKey;
    private string? status;
    private string? warning;

    private async Task StartAsync()
    {
        busy = true; warning = null; status = "Initialisiere…"; StateHasChanged();
        try
        {
            // 1) Schaue ob BLE überhaupt verfügbar ist
            var avail = await JS.InvokeAsync<bool>("eval", "!!window.SheetstormNative && (window.SheetstormNative.bleAvailable)");
            if (!avail)
            {
                warning = "BLE ist auf dieser Plattform nicht verfügbar (z.B. iOS-Safari). Nutze die native App oder warte auf den WLAN-Sync.";
                status = null;
                return;
            }

            // 2) Keypair lokal erzeugen
            var kp = await JS.InvokeAsync<KeyPairDto>("SheetstormNative.generateConductorKey");
            publicKey = kp.PublicKey;
            privateKey = kp.PrivateKey;

            // 3) Public-Key beim Backend hinterlegen
            var resp = await JS.InvokeAsync<bool>("eval",
                $"fetch('/api/events/{EventId}/conductor-key', {{ method: 'PUT', headers: {{ 'Content-Type': 'application/json' }}, credentials: 'include', body: JSON.stringify({{ publicKeyBase64: '{publicKey}' }}) }}).then(r => r.ok)");
            if (!resp)
            {
                warning = "Public-Key konnte nicht beim Server hinterlegt werden — versuche es noch einmal.";
                return;
            }

            // 4) Conductor-Mode starten — Capacitor-only.
            try
            {
                await JS.InvokeVoidAsync("SheetstormNative.startConductor");
                status = "BLE-Advertising aktiv";
                running = true;
            }
            catch (Microsoft.JSInterop.JSException jex)
            {
                warning = $"Native-Advertising nicht möglich ({jex.Message}). Public-Key wurde dennoch beim Server hinterlegt — sobald die native App benutzt wird, geht der Sync los.";
                running = false;
                status = null;
            }
        }
        catch (Exception e)
        {
            warning = "Fehler: " + e.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task StopAsync()
    {
        running = false;
        status = null;
        try { await JS.InvokeVoidAsync("eval", "(async ()=>{ try { /* TODO Stop-Native */ } catch{} })()"); } catch { }
    }

    public class KeyPairDto
    {
        public string PublicKey { get; set; } = "";
        public string PrivateKey { get; set; } = "";
        public string? Algorithm { get; set; }
    }
}
