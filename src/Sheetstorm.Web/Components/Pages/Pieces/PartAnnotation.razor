            await PartDetectionService.AddAnnotationAsync(
                partId, currentUserId, currentPage,
                x, y, w, h,
                PartAnnotationKind.RegionConfirmed, null, null);
            await ReloadAnnotationsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnRegionConfirmed fehlgeschlagen");
        }
    }

    private async Task OnCanvasClickEvent(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Tool-Mode entscheidet: ConfirmRegion ignoriert Click (das macht JS-Drag),
        // Click-Mode behandelt NH-Selektion + Missed-Note-Klicks.
        if (toolMode == ToolMode.ConfirmRegion) return;
        await OnCanvasClick(e);
    }

    private async Task OnCanvasClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        try
        {
            if (detections is null || detections.pages is null || currentPage >= detections.pages.Count)
                return;
            var page = detections.pages[currentPage];
            var coord = await GetClickCoordAsync(e.ClientX, e.ClientY);
            if (coord is null) return;

            NoteheadDto? hit = null;
            foreach (var nh in page.noteheads ?? new List<NoteheadDto>())
            {
                if (nh.bbox is null || nh.bbox.Length < 4) continue;
                if (coord.x >= nh.bbox[0] && coord.x <= nh.bbox[0] + nh.bbox[2]
                    && coord.y >= nh.bbox[1] && coord.y <= nh.bbox[1] + nh.bbox[3])
                { hit = nh; break; }
            }
            if (hit is not null)
            {
                selectedDetectionId = hit.id;
                pendingMissedClick = null;
                editorMode = EditorMode.None;
                await RenderCanvasAsync();
            }
            else
            {
                selectedDetectionId = null;
                var sp = (int)Math.Max(page.line_spacing, 8.0f);
                pendingMissedClick = (coord.x - sp / 2, coord.y - sp / 2);
                editorMidi = 60;
                editorDuration = 4;
                editorKind = "Filled";
                await RenderCanvasAsync();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnCanvasClick fehlgeschlagen");
        }
    }

    private async Task SetToolModeAsync(ToolMode m)
    {
        toolMode = m;
        try
        {
            // JS über aktuellen Tool-Mode informieren
            var dotnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("sheetstormAnnotate.setMode", m == ToolMode.ConfirmRegion ? "region" : "click", dotnetRef);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "JS setMode fehlgeschlagen");
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 0) { currentPage--; selectedDetectionId = null; pendingMissedClick = null; await RenderCanvasAsync(); }
    }
    private async Task NextPage()
    {
        if (currentPage + 1 < pageCount) { currentPage++; selectedDetectionId = null; pendingMissedClick = null; await RenderCanvasAsync(); }
    }

    private async Task RerunDetectionsAsync()
    {
        runningDetections = true;
        try
        {
            await PartDetectionService.StartDetectionsOnPartAsync(partId, ScopeFactory, Logger);
        }
        catch { }
        runningDetections = false;
    }

