            await using var scope = ScopeFactory.CreateAsyncScope();
            var freshDb = scope.ServiceProvider.GetRequiredService<SheetstormDbContext>();
            var pageFile = await freshDb.PartFiles
                .Where(f => f.PartId == partId && f.Kind == PartFileKind.PageImage && f.PageNumber == currentPage + 1)
                .FirstOrDefaultAsync();
            pageFileId = pageFile?.Id;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "PageFile-Lookup fehlgeschlagen");
