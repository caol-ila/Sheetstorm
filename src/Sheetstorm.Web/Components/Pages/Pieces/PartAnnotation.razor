    // Step-Modus: Index in der Detection-Liste der aktuellen Seite
    private int stepIndex;
    private NoteheadDto? stepDetection
    {
        get
        {
            var page = detections?.pages?.ElementAtOrDefault(currentPage);
            return page?.noteheads?.ElementAtOrDefault(stepIndex);
        }
    }
    private AnnotationDto? stepCurrentAnnotation
    {
        get
        {
            var nh = stepDetection;
            if (nh is null) return null;
            // Match per Bbox-Center
            return annotationsThisPage.FirstOrDefault(a =>
            {
                var ax = a.x + a.w / 2.0; var ay = a.y + a.h / 2.0;
                var nx = nh.bbox[0] + nh.bbox[2] / 2.0; var ny = nh.bbox[1] + nh.bbox[3] / 2.0;
                return Math.Abs(ax - nx) < 12 && Math.Abs(ay - ny) < 12;
            });
        }
    }

    private long? selectedDetectionId;
    private NoteheadDto? selectedDetection => detections?.pages?[currentPage]?.noteheads?.FirstOrDefault(n => n.id == selectedDetectionId);

    private (int x, int y)? pendingMissedClick;
    private EditorMode editorMode = EditorMode.None;

    // Region-Tool State
    private ToolMode toolMode = ToolMode.Click;
    private (int x, int y)? regionDragStart;
    private (int x, int y)? regionDragEnd;
    private bool regionDragging;

    private enum ToolMode { Click, ConfirmRegion }
    private string editorTitle = "";
    private int editorMidi = 60;
    private int editorDuration = 4;
    private string editorKind = "Filled";
    private string? editorComment;
    private string? editorText;
    private bool editorAllowsText;

    private enum EditorMode { None, Pitch, Duration, Kind, Comment, Note, Rest, SymbolPick }
    private enum SymbolCategory { Clef, TimeSignature, KeySignature, Barline, Jump, Dynamics, Tempo, Articulation, SlurTie, Other }

    private SymbolCategory? currentCategory;
    private string symbolCategoryLabel = "";
    private List<(SymbolType type, string label)> symbolOptions = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var u = auth.User?.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(auth.User) : null;
        if (u is null) { Navigation.NavigateTo("/login"); return; }
        currentUserId = u.Id;

        // Auth + Part-Lookup in eigenem Scope (Page-DbContext könnte parallel von OnAfterRender genutzt werden)
        await using var scope = ScopeFactory.CreateAsyncScope();
        var freshDb = scope.ServiceProvider.GetRequiredService<SheetstormDbContext>();
        part = await freshDb.Parts.AsNoTracking().FirstOrDefaultAsync(p => p.Id == partId);
        if (part is null) { loading = false; return; }
        var piece = await freshDb.Pieces.AsNoTracking().FirstOrDefaultAsync(p => p.Id == part.PieceId);
        if (piece is null) { loading = false; return; }
        var membership = await freshDb.Memberships.AsNoTracking()
            .FirstOrDefaultAsync(m => m.BandId == piece.BandId && m.UserId == u.Id);
        if (membership is null
            || (membership.Roles & (BandRole.Admin | BandRole.Owner | BandRole.Dirigent)) == 0)
        {
            notAuthorized = true;
            loading = false;
            return;
        }

        await LoadDetectionsAsync();
        try { await PageImagesService.EnsurePageImagesAsync(partId); } catch { }

        if (detections is null && !PartDetectionService.IsDetectionsRunning(partId))
        {
            try
            {
                await PartDetectionService.StartDetectionsOnPartAsync(partId, ScopeFactory, Logger);
                _ = AutoReloadDetectionsAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Auto-Trigger fuer Detections fehlgeschlagen");
            }
        }
        else if (detections is null && PartDetectionService.IsDetectionsRunning(partId))
        {
            _ = AutoReloadDetectionsAsync();
        }

        loading = false;
    }

    private async Task AutoReloadDetectionsAsync()
    {
        // Polle bis Detections fertig sind oder Timeout
        var deadline = DateTime.UtcNow.AddMinutes(3);
        while (detections is null && DateTime.UtcNow < deadline)
        {
            await Task.Delay(3000);
            await LoadDetectionsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadAfterDetectionAsync()
    {
        if (!PartDetectionService.IsDetectionsRunning(partId))
        {
            await PartDetectionService.StartDetectionsOnPartAsync(partId, ScopeFactory, Logger);
        }
        await LoadDetectionsAsync();
        StateHasChanged();
    }

    private async Task StepConfirmAsync()
    {
        var nh = stepDetection;
        if (nh is null) return;
        // Falls schon vorhandene Annotation für diese Detection: erst löschen
        if (stepCurrentAnnotation is not null)
        {
            await PartDetectionService.DeleteAnnotationAsync(stepCurrentAnnotation.id);
        }
        await PartDetectionService.AddAnnotationAsync(
            partId, currentUserId, currentPage,
            nh.bbox[0], nh.bbox[1], nh.bbox[2], nh.bbox[3],
            PartAnnotationKind.Confirmed, null, null);
        await ReloadAnnotationsAsync();
        StepNext();
    }

    private async Task StepNotANoteAsync()
    {
        var nh = stepDetection;
        if (nh is null) return;
        if (stepCurrentAnnotation is not null)
        {
            await PartDetectionService.DeleteAnnotationAsync(stepCurrentAnnotation.id);
        }
        await PartDetectionService.AddAnnotationAsync(
            partId, currentUserId, currentPage,
            nh.bbox[0], nh.bbox[1], nh.bbox[2], nh.bbox[3],
            PartAnnotationKind.NotANote, null, null);
        await ReloadAnnotationsAsync();
        StepNext();
    }

    private void StepNext()
    {
        var pageNhs = detections?.pages?.ElementAtOrDefault(currentPage)?.noteheads;
        if (pageNhs is null) return;
        if (stepIndex + 1 < pageNhs.Count)
        {
            stepIndex++;
        }
        else if (currentPage + 1 < pageCount)
        {
            currentPage++;
            stepIndex = 0;
            lastBoundImageUrl = null; // re-bind anderes Page-Image
        }
        selectedDetectionId = stepDetection?.id;
        editorMode = EditorMode.None;
        scrollToSelectionPending = true;
        _ = RenderCanvasAsync();
    }

    private void StepPrev()
    {
        if (stepIndex > 0)
        {
            stepIndex--;
        }
        else if (currentPage > 0)
        {
            currentPage--;
            var prevNhs = detections?.pages?.ElementAtOrDefault(currentPage)?.noteheads;
            stepIndex = Math.Max(0, (prevNhs?.Count ?? 1) - 1);
            lastBoundImageUrl = null;
        }
        selectedDetectionId = stepDetection?.id;
        editorMode = EditorMode.None;
        scrollToSelectionPending = true;
        _ = RenderCanvasAsync();
    }

    private void StepSkip() => StepNext();

    private void SetViewMode(ViewMode m)
    {
        viewMode = m;
        if (m == ViewMode.Step)
        {
            stepIndex = Math.Clamp(stepIndex, 0, Math.Max(0, (detections?.pages?.ElementAtOrDefault(currentPage)?.noteheads?.Count ?? 1) - 1));
            selectedDetectionId = stepDetection?.id;
            scrollToSelectionPending = true;
        }
        _ = RenderCanvasAsync();
    }

