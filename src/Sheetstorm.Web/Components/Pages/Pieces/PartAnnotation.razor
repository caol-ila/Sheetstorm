    private async Task RenderCanvasAsync()
    {
        if (detections is null || currentPage >= (detections.pages?.Count ?? 0)) return;
        var page = detections.pages![currentPage];

        var annKindByNhId = new Dictionary<long, int>();
        var missedAnnotations = new List<object>();
        var confirmedRegions = new List<object>();
        foreach (var a in annotationsThisPage)
        {
            if (a.kind == 7) // RegionConfirmed
            {
                confirmedRegions.Add(new { x = a.x, y = a.y, w = a.w, h = a.h, id = a.id });
                continue;
            }
            // Versuche Match zu einem existierenden NH (overlap > 50%)
            NoteheadDto? matched = null;
            foreach (var nh in page.noteheads ?? new List<NoteheadDto>())
            {
                var ix0 = Math.Max(a.x, nh.bbox[0]);
                var iy0 = Math.Max(a.y, nh.bbox[1]);
                var ix1 = Math.Min(a.x + a.w, nh.bbox[0] + nh.bbox[2]);
                var iy1 = Math.Min(a.y + a.h, nh.bbox[1] + nh.bbox[3]);
                var overlap = Math.Max(0, ix1 - ix0) * Math.Max(0, iy1 - iy0);
                var minArea = Math.Min(a.w * a.h, nh.bbox[2] * nh.bbox[3]);
                if (minArea > 0 && overlap * 2 > minArea) { matched = nh; break; }
            }
            if (matched is not null)
            {
                annKindByNhId[matched.id] = a.kind;
            }
            else if (a.kind == 4) // MissedNote
            {
                missedAnnotations.Add(new { x = a.x, y = a.y, w = a.w, h = a.h });
            }
        }

        object? dragRect = null;
        if (regionDragging && regionDragStart is { } s && regionDragEnd is { } end)
        {
            var rx = Math.Min(s.x, end.x);
            var ry = Math.Min(s.y, end.y);
            var rw = Math.Abs(end.x - s.x);
            var rh = Math.Abs(end.y - s.y);
            dragRect = new { x = rx, y = ry, w = rw, h = rh };
        }

        var payload = new
        {
            zoom = zoom,
            detW = page.width,
            detH = page.height,
            showNoteheads, showStems, showBars, showAnnotations,
            selectedId = selectedDetectionId,
            stepMode = viewMode == ViewMode.Step,
            _scrollToSelection = scrollToSelectionPending,
            noteheads = page.noteheads,
            stems = page.stems?.Select(s => new { x = s.x, yTop = s.y_top, yBot = s.y_bot }),
            bars = page.bars?.Select(b => new { x = b.x, yTop = b.y_top, yBot = b.y_bot }),
            annotatedIds = annKindByNhId,
            missedAnnotations,
            confirmedRegions,
            dragRect,
        };
        scrollToSelectionPending = false;
        await JS.InvokeVoidAsync("sheetstormAnnotate.render", "annotate-canvas", payload);
    }

    private bool scrollToSelectionPending;

    private async Task OnZoomInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
