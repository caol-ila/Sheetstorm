@page "/Bands/{slug}/pieces/{pieceId:guid}/parts/{partId:guid}/annotate"
@layout MainLayout
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject UserManager<ApplicationUser> UserManager
@inject SheetstormDbContext Db
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject Sheetstorm.Web.Application.PartDetectionService PartDetectionService
@inject Sheetstorm.Web.Application.PdfPageImageService PageImagesService
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<PartAnnotation> Logger
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Sheetstorm.Domain.Identity
@using Sheetstorm.Domain.Music
@using Sheetstorm.Infrastructure.Persistence

<PageTitle>Erkennung prüfen — @part?.DisplayName</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/annotation.css" />
</HeadContent>

@if (loading)
{
    <p>Lädt…</p>
}
else if (notAuthorized)
{
    <p class="alert alert-danger">Du hast keine Berechtigung, diese Stimme zu korrigieren.</p>
}
else if (part is null)
{
    <p class="alert alert-warning">Stimme nicht gefunden.</p>
}
else if (detections is null)
{
    <p><a href="/Bands/@slug/pieces/@pieceId" data-testid="annotate-back">← Zurück zum Werk</a></p>
    <h1>@part.DisplayName — Erkennung prüfen</h1>
    <div class="alert alert-info" data-testid="annotate-pending">
        <strong>⚙ Erkennung läuft…</strong>
        <p class="mb-0 small">
            Die OMR-Pipeline analysiert gerade die Notenseiten und erzeugt die Detection-Bboxes.
            Das dauert je nach Seitenzahl 5–30 Sekunden. Diese Seite aktualisiert sich automatisch.
        </p>
        <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                @onclick="ReloadAfterDetectionAsync" disabled="@runningDetections" data-testid="annotate-retry">
            @(runningDetections ? "🔄 Läuft…" : "🔄 Jetzt prüfen")
        </button>
    </div>
}
else
{
    <p><a href="/Bands/@slug/pieces/@pieceId" data-testid="annotate-back">← Zurück zum Werk</a></p>
    <h1 data-testid="annotate-title">@part.DisplayName — Erkennung prüfen</h1>
    <p class="text-muted small">
        Klicke auf einen erkannten Notenkopf für Korrekturen, oder auf eine leere Stelle um eine
        fehlende Note zu ergänzen. Im Schnell-Modus steppst du durch alle Erkennungen.
    </p>

    <div class="annotate-layout @(viewMode == ViewMode.Step ? "annotate-step" : "")">
        <div class="annotate-left">
            <div class="annotate-toolbar">
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        @onclick="PrevPage" disabled="@(currentPage == 0)" data-testid="annotate-prev">←</button>
                <span data-testid="annotate-page-label">Seite @(currentPage + 1) / @pageCount</span>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        @onclick="NextPage" disabled="@(currentPage + 1 >= pageCount)" data-testid="annotate-next">→</button>

                <span class="ms-2">Modus:</span>
                <button type="button" class="btn btn-sm @(viewMode == ViewMode.Step ? "btn-primary" : "btn-outline-primary")"
                        @onclick="@(() => SetViewMode(ViewMode.Step))" data-testid="annotate-mode-step"
                        title="Schnell-Modus: durch alle Detections steppen">
                    ⚡ Schnell
                </button>
                <button type="button" class="btn btn-sm @(viewMode == ViewMode.Free ? "btn-primary" : "btn-outline-primary")"
                        @onclick="@(() => SetViewMode(ViewMode.Free))" data-testid="annotate-mode-free"
                        title="Freier Modus: Klick + Drag">
                    🖱 Frei
                </button>

                <span class="ms-2">Zoom:</span>
                <input type="range" min="50" max="300" step="10"
                       value="@zoomPercent" @oninput="OnZoomInput"
                       data-testid="annotate-zoom" />
                <span>@zoomPercent%</span>

                <span class="ms-2">|</span>
                <label><input type="checkbox" @bind="showNoteheads" /> Noten</label>
                <label class="ms-1"><input type="checkbox" @bind="showStems" /> Stems</label>
                <label class="ms-1"><input type="checkbox" @bind="showBars" /> Takte</label>

                @if (viewMode == ViewMode.Free)
                {
                    <span class="ms-2">|</span>
                    <button type="button" class="btn btn-sm @(toolMode == ToolMode.Click ? "btn-primary" : "btn-outline-primary")"
                            @onclick="@(() => SetToolModeAsync(ToolMode.Click))" data-testid="annotate-tool-click">
                        🖱 Klick
                    </button>
                    <button type="button" class="btn btn-sm @(toolMode == ToolMode.ConfirmRegion ? "btn-success" : "btn-outline-success")"
                            @onclick="@(() => SetToolModeAsync(ToolMode.ConfirmRegion))" data-testid="annotate-tool-region">
                        ✓ Bereich
                    </button>
                }
            </div>

            <div class="annotate-canvas-wrap" id="annotate-wrap">
                <canvas id="annotate-canvas"
                        @onclick="OnCanvasClickEvent"
                        @onclick:preventDefault="true"
                        data-testid="annotate-canvas"></canvas>
            </div>
        </div>

        <div class="annotate-right">
            @if (viewMode == ViewMode.Step)
            {
                @if (stepDetection is not null)
                {
                    <div class="annotate-step-card" data-testid="annotate-step-card">
                        <div class="step-progress">
                            Element @(stepIndex + 1) von @(detections!.pages![currentPage].noteheads?.Count ?? 0)
                            @if (stepCurrentAnnotation is not null)
                            {
                                <span class="badge bg-@KindBadgeColor(stepCurrentAnnotation.kind) ms-1">@KindLabel(stepCurrentAnnotation.kind)</span>
                            }
                        </div>
                        <div class="step-summary">
                            Pipeline meint:
                            @if (stepDetection.midi.HasValue)
                            {
                                <span><b>Note @stepDetection.step@stepDetection.octave</b> (@DurationLabel(stepDetection.duration ?? 0))</span>
                            }
                            else
                            {
                                <span><b>@stepDetection.kind</b></span>
                            }
                        </div>

                        <div class="annotate-step-actions">
                            <button type="button" class="btn btn-success"
                                    @onclick="StepConfirmAsync" data-testid="step-correct"
                                    title="Pipeline-Erkennung ist genau richtig">
                                ✓ Korrekt
                            </button>
                            <button type="button" class="btn btn-outline-danger"
                                    @onclick="StepNotANoteAsync" data-testid="step-wrong"
                                    title="Hier ist gar kein Symbol (False-Positive)">
                                ✗ Hier ist nichts
                            </button>
                        </div>

                        <div class="annotate-step-nav">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="StepPrev" disabled="@(stepIndex == 0)" data-testid="step-prev">
                                ← Zurück
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="StepSkip" data-testid="step-skip">
                                Überspringen
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="StepNext" data-testid="step-next">
                                Weiter →
                            </button>
                        </div>

                        <details class="mt-2" open="@(editorMode != EditorMode.None)">
                            <summary class="small text-muted">Was anderes…</summary>
                            <div class="mt-2">
                                <p class="small mb-1"><b>Korrekter Symboltyp:</b></p>
                                <div class="d-grid gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                            @onclick="OpenNoteEditor" data-testid="step-symbol-note">🎵 Note (anderer Pitch/Dauer)</button>
                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                            @onclick="OpenRestEditor" data-testid="step-symbol-rest">😶 Pause</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.Clef))">🎼 Notenschlüssel</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.TimeSignature))">⏱ Taktangabe</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.KeySignature))">♯♭ Vorzeichen</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.Barline))">| Taktstrich/Repeat</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.Jump))">𝄋 Sprungmarke (DC/DS/Coda/Segno/Fine/Volta)</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.Dynamics))">𝆑 Dynamik (p/f/cresc./...)</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.Tempo))">⏩ Tempo (rit/accel/BPM)</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.Articulation))">⌃ Artikulation (Akzent/Staccato/Bogen)</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.SlurTie))">⌒ Bindebogen/Haltebogen</button>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            @onclick="@(() => OpenSymbolEditor(SymbolCategory.Other))">🔣 Sonstiges/Text</button>
                                </div>
                            </div>

                            @if (editorMode == EditorMode.Note)
                            {
                                <hr/>
                                <p class="small mb-1"><b>Note-Korrektur</b></p>
                                <label class="small">MIDI-Pitch (60 = C4, 72 = C5)</label>
                                <input type="number" min="0" max="127" @bind="editorMidi" class="form-control form-control-sm mb-1" />
                                <label class="small">Dauer</label>
                                <select @bind="editorDuration" class="form-select form-select-sm mb-1">
                                    <option value="1">Sechzehntel</option>
                                    <option value="2">Achtel</option>
                                    <option value="3">Punkt. Achtel</option>
                                    <option value="4">Viertel</option>
                                    <option value="6">Punkt. Viertel</option>
                                    <option value="8">Halbe</option>
                                    <option value="12">Punkt. Halbe</option>
                                    <option value="16">Ganze</option>
                                </select>
                                <button class="btn btn-sm btn-primary" @onclick="SaveNoteAsync" data-testid="step-save-note">Speichern + Weiter</button>
                            }
                            else if (editorMode == EditorMode.Rest)
                            {
                                <hr/>
                                <p class="small mb-1"><b>Pause</b></p>
                                <label class="small">Dauer</label>
                                <select @bind="editorDuration" class="form-select form-select-sm mb-1">
                                    <option value="1">Sechzehntel</option>
                                    <option value="2">Achtel</option>
                                    <option value="4">Viertel</option>
                                    <option value="8">Halbe</option>
                                    <option value="16">Ganze</option>
                                </select>
                                <button class="btn btn-sm btn-primary" @onclick="SaveRestAsync" data-testid="step-save-rest">Speichern + Weiter</button>
                            }
                            else if (editorMode == EditorMode.SymbolPick && symbolOptions.Count > 0)
                            {
                                <hr/>
                                <p class="small mb-1"><b>@symbolCategoryLabel</b></p>
                                <div class="d-grid gap-1">
                                    @foreach (var opt in symbolOptions)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary text-start"
                                                @onclick="@(() => SaveSymbolAsync(opt.type))">@opt.label</button>
                                    }
                                </div>
                                @if (editorAllowsText)
                                {
                                    <label class="small mt-2">Optionaler Text</label>
                                    <input type="text" @bind="editorText" class="form-control form-control-sm" placeholder="z.B. 'molto rit.'" />
                                }
                            }
                        </details>
                    </div>
                }
                else
                {
                    <p class="text-muted">Keine Detections auf dieser Seite.</p>
                }

                <hr/>
                <h5 class="mt-2">Statistik</h5>
                @if (coverage.total > 0)
                {
                    var pct = (int)(100.0 * (coverage.confirmed + coverage.corrected) / Math.Max(1, coverage.total));
                    <div class="progress mb-2" style="height:14px;" data-testid="annotate-coverage">
                        <div class="progress-bar bg-success" style="width:@(100.0*coverage.confirmed/Math.Max(1,coverage.total))%"></div>
                        <div class="progress-bar bg-warning" style="width:@(100.0*coverage.corrected/Math.Max(1,coverage.total))%"></div>
                    </div>
                    <p class="small text-muted" data-testid="annotate-coverage-text">
                        ✓ @coverage.confirmed bestätigt, ✏ @coverage.corrected korrigiert, ⏳ @coverage.uncertain unbestätigt (@pct% gelabelt)
                    </p>
                }
            }
            else
            {
                <h4>Korrekturen Seite @(currentPage + 1)</h4>
                <p class="text-muted small mb-2">
                    @annotationsThisPage.Count Eintrag/Einträge auf dieser Seite,
                    @allAnnotations.Count gesamt.
                </p>
                @if (coverage.total > 0)
                {
                    var pct = (int)(100.0 * (coverage.confirmed + coverage.corrected) / Math.Max(1, coverage.total));
                    <div class="progress mb-2" style="height:14px;" data-testid="annotate-coverage">
                        <div class="progress-bar bg-success" style="width:@(100.0*coverage.confirmed/Math.Max(1,coverage.total))%"></div>
                        <div class="progress-bar bg-warning" style="width:@(100.0*coverage.corrected/Math.Max(1,coverage.total))%"></div>
                    </div>
                    <p class="small text-muted mb-2" data-testid="annotate-coverage-text">
                        ✓ @coverage.confirmed bestätigt &middot;
                        ✏ @coverage.corrected korrigiert &middot;
                        ⏳ @coverage.uncertain unbestätigt
                        (@pct% gelabelt)
                    </p>
                }

                @if (CurrentPageAnomalies().Count > 0)
                {
                    var anomalies = CurrentPageAnomalies();
                    <div class="card mb-2 border-warning" data-testid="annotate-anomalies">
                        <div class="card-body py-2">
                            <h6 class="card-title mb-1">⚠ Auffälligkeiten beim Lesen (@anomalies.Count)</h6>
                            <p class="small text-muted mb-2">Stellen, an denen das System unsicher gelesen hat — diese zuerst prüfen!</p>
                            <ul class="small mb-0">
                                @foreach (var a in anomalies.Take(10))
                                {
                                    <li>
                                        @switch (a.type)
                                        {
                                            case "note_in_header":
                                                <span><b>Note im Header</b> (x=@a.x): vermutlich Vorzeichen oder Schlüssel falsch erkannt</span>
                                                break;
                                            case "beat_mismatch":
                                                <span><b>Takt @a.measure</b>: erwartet @a.expected_beats Beats, gefunden @a.actual_beats — fehlende oder zusätzliche Note?</span>
                                                break;
                                            case "empty_measure":
                                                <span><b>Takt @a.measure</b> ist leer — Pause vergessen oder Erkennung fehlgeschlagen</span>
                                                break;
                                            case "orphan_note_after_final_bar":
                                                <span><b>Orphan-Note</b> nach letztem Taktstrich (x=@a.x): vermutlich Volta-Digit oder Anhang-Symbol</span>
                                                break;
                                            case "duplicate_clef":
                                                <span>Mehrere Notenschlüssel direkt hintereinander — einer falsch erkannt</span>
                                                break;
                                            default:
                                                <span>@a.type</span>
                                                break;
                                        }
                                    </li>
                                }
                                @if (anomalies.Count > 10)
                                {
                                    <li class="text-muted">... und @(anomalies.Count - 10) weitere</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

            @if (selectedDetectionId.HasValue && selectedDetection is not null)
            {
                <div class="card mb-2 annotate-selected-card" data-testid="annotate-selected-card">
                    <div class="card-body">
                        <h5 class="card-title">Erkannte Note (id #@selectedDetection.id)</h5>
                        <ul class="small">
                            <li>Typ: <b>@selectedDetection.kind</b></li>
                            @if (selectedDetection.midi.HasValue)
                            {
                                <li>Pitch: <b>@selectedDetection.step@selectedDetection.octave</b> (MIDI @selectedDetection.midi)</li>
                            }
                            @if (selectedDetection.duration.HasValue)
                            {
                                <li>Dauer: <b>@DurationLabel(selectedDetection.duration.Value)</b> (@selectedDetection.duration ticks)</li>
                            }
                            @if (selectedDetection.measure_number.HasValue)
                            {
                                <li>Takt: @selectedDetection.measure_number</li>
                            }
                        </ul>

                        <p class="small mb-1"><b>Was ist mit dieser Note?</b></p>
                        <div class="d-grid gap-1">
                            <button type="button" class="btn btn-sm btn-success"
                                    @onclick="() => MarkAsync(PartAnnotationKind.Confirmed, null)"
                                    data-testid="annotate-confirmed">✓ Korrekt erkannt</button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    @onclick="() => MarkAsync(PartAnnotationKind.NotANote, null)"
                                    data-testid="annotate-not-a-note">❌ Keine Note (False-Positive)</button>
                            <button type="button" class="btn btn-sm btn-outline-warning"
                                    @onclick="() => OpenPitchEditor()"
                                    data-testid="annotate-wrong-pitch">🎵 Falscher Pitch…</button>
                            <button type="button" class="btn btn-sm btn-outline-warning"
                                    @onclick="() => OpenDurationEditor()"
                                    data-testid="annotate-wrong-duration">⏱ Falsche Dauer…</button>
                            <button type="button" class="btn btn-sm btn-outline-warning"
                                    @onclick="() => OpenKindEditor()"
                                    data-testid="annotate-wrong-kind">⚪ Falsche Klassifikation…</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => OpenCommentEditor()"
                                    data-testid="annotate-comment">💬 Kommentar…</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => selectedDetectionId = null"
                                    data-testid="annotate-deselect">Auswahl aufheben</button>
                        </div>

                        @if (editorMode != EditorMode.None)
                        {
                            <hr/>
                            <p class="small mb-1"><b>@editorTitle</b></p>
                            @if (editorMode == EditorMode.Pitch)
                            {
                                <div class="d-flex gap-1">
                                    <input type="number" min="0" max="127" @bind="editorMidi" class="form-control form-control-sm" placeholder="MIDI 0-127" />
                                    <button class="btn btn-sm btn-primary" @onclick="SavePitchAsync">OK</button>
                                </div>
                            }
                            else if (editorMode == EditorMode.Duration)
                            {
                                <select @bind="editorDuration" class="form-select form-select-sm">
                                    <option value="1">Sechzehntel (1)</option>
                                    <option value="2">Achtel (2)</option>
                                    <option value="4">Viertel (4)</option>
                                    <option value="8">Halbe (8)</option>
                                    <option value="16">Ganze (16)</option>
                                </select>
                                <button class="btn btn-sm btn-primary mt-1" @onclick="SaveDurationAsync">OK</button>
                            }
                            else if (editorMode == EditorMode.Kind)
                            {
                                <select @bind="editorKind" class="form-select form-select-sm">
                                    <option value="Filled">Filled (Viertel/Achtel)</option>
                                    <option value="Open">Open (Halbe)</option>
                                    <option value="Whole">Whole (Ganze)</option>
                                </select>
                                <button class="btn btn-sm btn-primary mt-1" @onclick="SaveKindAsync">OK</button>
                            }
                            else if (editorMode == EditorMode.Comment)
                            {
                                <textarea @bind="editorComment" class="form-control form-control-sm" rows="3" placeholder="Anmerkung…"></textarea>
                                <button class="btn btn-sm btn-primary mt-1" @onclick="SaveCommentAsync">OK</button>
                            }
                        }
                    </div>
                </div>
            }
            else if (pendingMissedClick is not null)
            {
                <div class="card mb-2 annotate-missed-card" data-testid="annotate-missed-card">
                    <div class="card-body">
                        <h5 class="card-title">Fehlende Note ergänzen</h5>
                        <p class="small">An dieser Stelle ist keine Note erkannt. Welche Note sollte hier sein?</p>
                        <label class="small">MIDI</label>
                        <input type="number" min="0" max="127" @bind="editorMidi" class="form-control form-control-sm mb-1" />
                        <label class="small">Dauer</label>
                        <select @bind="editorDuration" class="form-select form-select-sm mb-1">
                            <option value="1">Sechzehntel</option>
                            <option value="2">Achtel</option>
                            <option value="4">Viertel</option>
                            <option value="8">Halbe</option>
                            <option value="16">Ganze</option>
                        </select>
                        <label class="small">Typ</label>
                        <select @bind="editorKind" class="form-select form-select-sm mb-1">
                            <option value="Filled">Filled</option>
                            <option value="Open">Open</option>
                            <option value="Whole">Whole</option>
                        </select>
                        <div class="d-flex gap-1 mt-2">
                            <button class="btn btn-sm btn-success" @onclick="SaveMissedAsync" data-testid="annotate-save-missed">Speichern</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => pendingMissedClick = null">Abbrechen</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted small" data-testid="annotate-help">
                    💡 Klick auf eine erkannte Note (rotes/gelbes Kästchen) für Korrekturen,
                    oder auf eine leere Stelle für eine fehlende Note.
                </p>
            }

            <h5 class="mt-3">Liste der Korrekturen</h5>
            @if (annotationsThisPage.Count == 0)
            {
                <p class="text-muted small">Noch keine Korrekturen auf dieser Seite.</p>
            }
            else
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var a in annotationsThisPage)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-@KindBadgeColor(a.kind)">@KindLabel(a.kind)</span>
                                @if (!string.IsNullOrEmpty(a.correctionJson))
                                {
                                    <code class="ms-1">@a.correctionJson</code>
                                }
                                @if (!string.IsNullOrEmpty(a.comment))
                                {
                                    <div class="text-muted">"@a.comment"</div>
                                }
                            </div>
                            <button class="btn btn-sm btn-link text-danger p-0"
                                    @onclick="() => DeleteAnnotationAsync(a.id)"
                                    data-testid="annotate-delete-@a.id">×</button>
                        </li>
                    }
                </ul>
            }
            }
        </div>
    </div>
}

<script>
window.sheetstormAnnotate = window.sheetstormAnnotate || {
    pageImage: null,
    mode: 'click',
    dotnetRef: null,
    dragStart: null,
    dragEnd: null,
    dragging: false,
    lastPayload: null,
    setMode: function(mode, dotnetRef) {
        this.mode = mode;
        if (dotnetRef) this.dotnetRef = dotnetRef;
        const canvas = document.getElementById('annotate-canvas');
        if (!canvas) return;
        if (canvas._ssBound) return;
        canvas._ssBound = true;
        canvas.addEventListener('mousedown', (e) => {
            if (this.mode !== 'region') return;
            const c = this._coord(canvas, e.clientX, e.clientY);
            this.dragStart = c;
            this.dragEnd = c;
            this.dragging = true;
            this._renderOverlay();
            e.preventDefault();
        });
        canvas.addEventListener('mousemove', (e) => {
            if (!this.dragging) return;
            this.dragEnd = this._coord(canvas, e.clientX, e.clientY);
            this._renderOverlay();
        });
        canvas.addEventListener('mouseup', (e) => {
            if (!this.dragging) return;
            this.dragging = false;
            const s = this.dragStart, ed = this.dragEnd;
            this.dragStart = null;
            this.dragEnd = null;
            this._renderOverlay();
            if (s && ed && this.dotnetRef) {
                const x = Math.min(s.x, ed.x);
                const y = Math.min(s.y, ed.y);
                const w = Math.abs(ed.x - s.x);
                const h = Math.abs(ed.y - s.y);
                if (w >= 8 && h >= 8) {
                    this.dotnetRef.invokeMethodAsync('OnRegionConfirmed', x, y, w, h)
                        .catch(err => console.warn('Region-Confirm fehlgeschlagen', err));
                }
            }
            e.preventDefault();
        });
        canvas.addEventListener('mouseleave', () => {
            if (this.dragging) {
                this.dragging = false;
                this.dragStart = null;
                this.dragEnd = null;
                this._renderOverlay();
            }
        });
    },
    _coord: function(canvas, clientX, clientY) {
        const r = canvas.getBoundingClientRect();
        const localX = clientX - r.left;
        const localY = clientY - r.top;
        const p = this.lastPayload;
        if (!p) return { x: 0, y: 0 };
        const sx = canvas.width / p.detW;
        const sy = canvas.height / p.detH;
        return { x: Math.round(localX / sx), y: Math.round(localY / sy) };
    },
    _renderOverlay: function() {
        // Re-render basierend auf letztem Payload (zeichnet auch dragRect)
        if (this.lastPayload) this.render('annotate-canvas', { ...this.lastPayload, _liveDrag: true });
    },
    bind: function(canvasId, imageUrl, width, height) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        const img = new Image();
        img.onload = () => {
            window.sheetstormAnnotate.pageImage = img;
            // Sofort re-rendern wenn ein Payload schon da ist (LoadDetections lief vor Bild-Load).
            if (window.sheetstormAnnotate.lastPayload) {
                window.sheetstormAnnotate.render(canvasId, window.sheetstormAnnotate.lastPayload);
            }
        };
        img.onerror = (e) => {
            console.warn('Page-Image konnte nicht geladen werden:', imageUrl, e);
        };
        img.src = imageUrl;
    },
    render: function(canvasId, payload) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        // Live-Drag merge: dragRect aus JS-State kommt aus Drag-Handler
        if (this.dragging && this.dragStart && this.dragEnd) {
            const s = this.dragStart, ed = this.dragEnd;
            payload = { ...payload, dragRect: {
                x: Math.min(s.x, ed.x), y: Math.min(s.y, ed.y),
                w: Math.abs(ed.x - s.x), h: Math.abs(ed.y - s.y)
            }};
        }
        if (!payload._liveDrag) this.lastPayload = payload;
        const ctx = canvas.getContext('2d');
        const img = window.sheetstormAnnotate.pageImage;
        if (!img) return;
        const zoom = payload.zoom || 1.0;
        const W = Math.round(img.naturalWidth * zoom);
        const H = Math.round(img.naturalHeight * zoom);
        canvas.width = W;
        canvas.height = H;
        ctx.imageSmoothingEnabled = true;
        ctx.drawImage(img, 0, 0, W, H);

        const sx = (W / payload.detW);
        const sy = (H / payload.detH);

        // Step-Modus: Highlight für aktuelle Detection — keine Bildmodifikation,
        // nur fetter Rahmen + Pfeil + Label. Bild bleibt komplett sichtbar.
        const stepMode = payload.stepMode === true && payload.selectedId !== undefined && payload.selectedId !== null;
        let selectedNh = null;
        if (stepMode && payload.noteheads) {
            for (const nh of payload.noteheads) {
                if (nh.id === payload.selectedId) { selectedNh = nh; break; }
            }
        }

        if (payload.showStems) {
            ctx.strokeStyle = 'rgba(0,200,0,0.6)';
            ctx.lineWidth = 1;
            for (const s of payload.stems) {
                ctx.beginPath();
                ctx.moveTo(s.x*sx, s.yTop*sy);
                ctx.lineTo(s.x*sx, s.yBot*sy);
                ctx.stroke();
            }
        }
        if (payload.showBars) {
            ctx.strokeStyle = 'rgba(160,0,200,0.6)';
            ctx.lineWidth = 2;
            for (const b of payload.bars) {
                ctx.beginPath();
                ctx.moveTo(b.x*sx, b.yTop*sy);
                ctx.lineTo(b.x*sx, b.yBot*sy);
                ctx.stroke();
            }
        }
        if (payload.showNoteheads) {
            for (const nh of payload.noteheads) {
                const annKind = payload.annotatedIds[nh.id];
                if (nh.id === payload.selectedId) {
                    // PRIO 1: aktuelle Selection — sehr fetter pulsierender Rahmen + Pfeil
                    continue; // erst nach dem Loop zeichnen damit es oben liegt
                }
                if (annKind === 0) {
                    ctx.strokeStyle = 'rgba(180,180,180,0.9)';
                    ctx.lineWidth = 1;
                    ctx.setLineDash([3,3]);
                } else if (annKind === 6) {
                    ctx.strokeStyle = 'rgba(40,180,80,1.0)';
                    ctx.lineWidth = 2;
                    ctx.setLineDash([]);
                } else if (annKind !== undefined) {
                    ctx.strokeStyle = 'rgba(255,165,0,0.9)';
                    ctx.lineWidth = 2;
                    ctx.setLineDash([]);
                } else if (nh.kind === 'Filled') {
                    ctx.strokeStyle = 'rgba(220,40,40,0.85)';
                    ctx.lineWidth = 1;
                    ctx.setLineDash([]);
                } else if (nh.kind === 'Open') {
                    ctx.strokeStyle = 'rgba(255,200,0,0.85)';
                    ctx.lineWidth = 1;
                    ctx.setLineDash([]);
                } else {
                    ctx.strokeStyle = 'rgba(0,150,200,0.85)';
                    ctx.lineWidth = 1;
                    ctx.setLineDash([]);
                }
                ctx.strokeRect(nh.bbox[0]*sx, nh.bbox[1]*sy, nh.bbox[2]*sx, nh.bbox[3]*sy);
            }
            ctx.setLineDash([]);
        }
        if (payload.showAnnotations && payload.confirmedRegions) {
            for (const r of payload.confirmedRegions) {
                ctx.strokeStyle = 'rgba(40,180,80,0.9)';
                ctx.fillStyle = 'rgba(40,180,80,0.10)';
                ctx.lineWidth = 2;
                ctx.fillRect(r.x*sx, r.y*sy, r.w*sx, r.h*sy);
                ctx.strokeRect(r.x*sx, r.y*sy, r.w*sx, r.h*sy);
            }
        }
        if (payload.showAnnotations) {
            for (const ma of payload.missedAnnotations) {
                ctx.strokeStyle = 'rgba(0,140,255,0.95)';
                ctx.fillStyle = 'rgba(0,140,255,0.18)';
                ctx.lineWidth = 2;
                ctx.fillRect(ma.x*sx, ma.y*sy, ma.w*sx, ma.h*sy);
                ctx.strokeRect(ma.x*sx, ma.y*sy, ma.w*sx, ma.h*sy);
            }
        }
        // Aktuelle Selection als halbtransparenter gelber Kreis, 30% größer als die Bbox
        if (selectedNh) {
            const x = selectedNh.bbox[0] * sx;
            const y = selectedNh.bbox[1] * sy;
            const w = selectedNh.bbox[2] * sx;
            const h = selectedNh.bbox[3] * sy;
            const cx = x + w / 2;
            const cy = y + h / 2;
            const r = Math.max(w, h) / 2 * 1.3; // 30% größer als die Bbox
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255,200,0,0.35)';
            ctx.fill();
            ctx.strokeStyle = 'rgba(220,150,0,0.9)';
            ctx.lineWidth = 2;
            ctx.stroke();

            if (payload._scrollToSelection) {
                const wrap = document.getElementById('annotate-wrap');
                if (wrap) {
                    wrap.scrollTo({
                        left: Math.max(0, cx - wrap.clientWidth / 2),
                        top: Math.max(0, cy - wrap.clientHeight / 2),
                        behavior: 'smooth'
                    });
                }
            }
        }

        if (payload.dragRect) {
            const r = payload.dragRect;
            ctx.strokeStyle = 'rgba(40,180,80,1.0)';
            ctx.fillStyle = 'rgba(40,180,80,0.20)';
            ctx.lineWidth = 2;
            ctx.setLineDash([6,4]);
            ctx.fillRect(r.x*sx, r.y*sy, r.w*sx, r.h*sy);
            ctx.strokeRect(r.x*sx, r.y*sy, r.w*sx, r.h*sy);
            ctx.setLineDash([]);
        }
    },
    getClickInDetectionCoords: function(canvasId, evtX, evtY, detW, detH) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return null;
        const r = canvas.getBoundingClientRect();
        const localX = evtX - r.left;
        const localY = evtY - r.top;
        const sx = canvas.width / detW;
        const sy = canvas.height / detH;
        return { x: Math.round(localX / sx), y: Math.round(localY / sy) };
    }
};
