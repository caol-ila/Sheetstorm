            detections = System.Text.Json.JsonSerializer.Deserialize<DetectionsDto>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            pageCount = detections?.pages?.Count ?? 0;

            var anns = await PartDetectionService.GetAnnotationsAsync(partId);
            allAnnotations = anns.Select(a => new AnnotationDto(
                a.Id, a.PageIndex, a.BboxX, a.BboxY, a.BboxW, a.BboxH,
                (int)a.Kind, a.CorrectionJson, a.Comment)).ToList();
            try { coverage = await PartDetectionService.GetCoverageAsync(partId); } catch { }
        }
        catch (Exception)
        {
