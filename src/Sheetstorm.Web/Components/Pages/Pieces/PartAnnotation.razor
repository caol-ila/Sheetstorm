    [Parameter] public Guid partId { get; set; }

    private Part? part;
    private bool loading = true;
    private bool notAuthorized;
    private Guid currentUserId;
    private bool runningDetections;

    // Detection-Daten (vom Server geladen)
    private DetectionsDto? detections;
    private int currentPage;
    private int pageCount;

    // Annotations
    private List<AnnotationDto> allAnnotations = new();
    private List<AnnotationDto> annotationsThisPage => allAnnotations.Where(a => a.pageIndex == currentPage).ToList();

    // UI-State
    private int zoomPercent = 100;
    private double zoom => zoomPercent / 100.0;
    private bool showNoteheads = true;
    private bool showStems = true;
    private bool showBars = true;
    private bool showAnnotations = true;

    // ViewMode = Step (schnell durchklicken) | Free (freie Selection)
    private ViewMode viewMode = ViewMode.Step;
