@page "/Bands/{slug}/pieces/{pieceId:guid}/edit"
@layout MainLayout
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject SheetstormDbContext Db
@inject PieceService PieceService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Sheetstorm.Domain.Identity
@using Sheetstorm.Domain.Music
@using Sheetstorm.Infrastructure.Persistence
@using Sheetstorm.Web.Application

<PageTitle>Werk bearbeiten — @(piece?.Title ?? "")</PageTitle>

@if (piece is null)
{
    <p>Lädt…</p>
}
else
{
    <p><a href="/Bands/@slug/pieces/@pieceId" data-testid="piece-edit-back">← Zurück zum Werk</a></p>
    <h1>Werk bearbeiten: @piece.Title</h1>

    <EditForm Model="Input" OnValidSubmit="SaveAsync" FormName="piece-edit" class="ss-card">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Titel *</label>
                <InputText @bind-Value="Input!.Title" data-testid="piece-edit-title" class="form-control" />
                <ValidationMessage For="() => Input.Title" class="text-danger" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Komponist</label>
                <InputText @bind-Value="Input.Composer" data-testid="piece-edit-composer" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Genre</label>
                <InputText @bind-Value="Input.Genre" data-testid="piece-edit-genre" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Schwierigkeit (1-6)</label>
                <InputNumber @bind-Value="Input.Difficulty" data-testid="piece-edit-difficulty" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label">Notizen</label>
                <InputTextArea @bind-Value="Input.Notes" data-testid="piece-edit-notes" class="form-control" rows="3" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="ss-btn ss-btn-primary" data-testid="piece-edit-save">Speichern</button>
            <a href="/Bands/@slug/pieces/@pieceId" class="ss-btn ss-btn-ghost">Abbrechen</a>
        </div>
    </EditForm>

    <div class="ss-card border-danger mt-3">
        <h3 class="text-danger">Werk löschen</h3>
        <p>Das Werk wird soft-deleted (kann später wiederhergestellt werden).</p>
        <EditForm Model="DeleteInput" OnValidSubmit="DeleteAsync" FormName="piece-delete">
            <button type="submit" class="ss-btn" style="background:#dc2626;color:white" data-testid="piece-edit-delete">Werk löschen</button>
        </EditForm>
    </div>
}

@code {
    [Parameter] public string slug { get; set; } = default!;
    [Parameter] public Guid pieceId { get; set; }

    private Piece? piece;
    private bool canEdit;
    private Guid currentUserId;

    [SupplyParameterFromForm(FormName = "piece-edit")]
    private InputModel? Input { get; set; }

    [SupplyParameterFromForm(FormName = "piece-delete")]
    private DeleteInputModel? DeleteInput { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        DeleteInput ??= new();

        var auth = await AuthState.GetAuthenticationStateAsync();
        var u = await UserManager.GetUserAsync(auth.User);
        if (u is null) { Navigation.NavigateTo("/Account/Login"); return; }
        currentUserId = u.Id;

        var band = await Db.Bands.FirstOrDefaultAsync(b => b.Slug == slug);
        if (band is null) { Navigation.NavigateTo("/Bands"); return; }
        var myMem = await Db.Memberships.FirstOrDefaultAsync(m => m.BandId == band.Id && m.UserId == currentUserId);
        canEdit = myMem is not null && (myMem.HasRole(BandRole.Admin) || myMem.HasRole(BandRole.Owner) || myMem.HasRole(BandRole.Dirigent));
        if (!canEdit) { Navigation.NavigateTo($"/Bands/{slug}/pieces/{pieceId}"); return; }

        piece = await Db.Pieces.FirstOrDefaultAsync(p => p.Id == pieceId && p.BandId == band.Id);
        if (piece is null) { Navigation.NavigateTo($"/Bands/{slug}/pieces"); return; }

        if (string.IsNullOrEmpty(Input.Title))
        {
            Input.Title = piece.Title;
            Input.Composer = piece.Composer;
            Input.Genre = piece.Genre;
            Input.Difficulty = piece.Difficulty;
            Input.Notes = piece.Notes;
        }
    }

    private async Task SaveAsync()
    {
        if (piece is null || Input is null || string.IsNullOrWhiteSpace(Input.Title)) return;
        await PieceService.UpdateMetadataAsync(piece.Id, Input.Title, Input.Composer, Input.Genre, Input.Difficulty, Input.Notes);
        Navigation.NavigateTo($"/Bands/{slug}/pieces/{pieceId}");
    }

    private async Task DeleteAsync()
    {
        if (piece is null) return;
        await PieceService.SoftDeleteAsync(piece.Id);
        Navigation.NavigateTo($"/Bands/{slug}/pieces");
    }

    private sealed class InputModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(300, MinimumLength = 1)]
        public string Title { get; set; } = "";
        public string? Composer { get; set; }
        public string? Genre { get; set; }
        [System.ComponentModel.DataAnnotations.Range(1, 6)]
        public int? Difficulty { get; set; }
        public string? Notes { get; set; }
    }
    private sealed class DeleteInputModel { }
}
