@page "/Bands/{slug}/events/{eventId:guid}/shifts"
@layout MainLayout
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject SheetstormDbContext Db
@inject EventService EventService
@inject ShiftService ShiftService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Sheetstorm.Domain.Identity
@using Sheetstorm.Domain.Events
@using Sheetstorm.Infrastructure.Persistence
@using Sheetstorm.Web.Application

<PageTitle>Schichten — @(ev?.Title ?? "")</PageTitle>

<p><a href="/Bands/@slug/events" data-testid="shifts-back">← Zurück zu Terminen</a></p>

@if (ev is null)
{
    <p>Lädt…</p>
}
else
{
    <h1 data-testid="shifts-heading">Schichten — @ev.Title</h1>
    <p class="ss-page-intro">@(ev.Type == EventType.Arbeitseinsatz ? "Trage dich in eine Schicht ein." : "Schichten kannst du auch für andere Termin-Typen anlegen.")</p>

    @if (canEdit)
    {
        <div class="ss-card">
            <h2 class="mt-0">Schicht anlegen</h2>
            <EditForm Model="CreateInput" OnValidSubmit="CreateAsync" FormName="shift-create">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Titel</label>
                        <InputText @bind-Value="CreateInput!.Title" data-testid="shift-create-title" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Start</label>
                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="CreateInput.Start" data-testid="shift-create-start" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ende</label>
                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="CreateInput.End" data-testid="shift-create-end" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Bedarf</label>
                        <InputNumber @bind-Value="CreateInput.RequiredCount" data-testid="shift-create-required" class="form-control" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="ss-btn ss-btn-primary" data-testid="shift-create-submit">+</button>
                    </div>
                </div>
            </EditForm>
        </div>
    }

    @if (shifts.Count == 0)
    {
        <div class="ss-empty mt-3" data-testid="shifts-empty">
            <div class="ss-empty-icon">📋</div>
            <div class="ss-empty-title">Noch keine Schichten angelegt.</div>
        </div>
    }
    else
    {
        <table class="table mt-3" data-testid="shifts-list">
            <thead>
                <tr><th>Schicht</th><th>Zeit</th><th>Belegung</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in shifts)
                {
                    <tr data-testid="shift-row">
                        <td><strong data-testid="shift-title">@s.Title</strong></td>
                        <td>@s.StartUtc.LocalDateTime.ToString("dd.MM. HH:mm")<text>–</text>@s.EndUtc.LocalDateTime.ToString("HH:mm")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height:.6rem;min-width:8rem;">
                                    <div class="progress-bar @(s.AssignedCount >= s.RequiredCount ? "bg-success" : "bg-warning")"
                                         role="progressbar" style="width: @((s.RequiredCount == 0 ? 100 : Math.Min(100, s.AssignedCount * 100 / s.RequiredCount)))%"></div>
                                </div>
                                <span data-testid="shift-fill">@s.AssignedCount / @s.RequiredCount</span>
                            </div>
                        </td>
                        <td>
                            <EditForm Model="ToggleInput" OnValidSubmit="ToggleAsync" FormName="@($"toggle-{s.Id}")" class="d-inline">
                                <input type="hidden" name="ToggleInput.ShiftId" value="@s.Id" />
                                <button type="submit" class="btn btn-sm @(s.IsAssignedToMe ? "btn-outline-danger" : "btn-outline-primary")" data-testid="shift-toggle">
                                    @(s.IsAssignedToMe ? "Austragen" : "Eintragen")
                                </button>
                            </EditForm>
                            @if (canEdit)
                            {
                                <EditForm Model="DeleteInput" OnValidSubmit="DeleteAsync" FormName="@($"del-{s.Id}")" class="d-inline ms-1">
                                    <input type="hidden" name="DeleteInput.ShiftId" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" data-testid="shift-delete"
                                            onclick="return confirm('Schicht löschen?');">×</button>
                                </EditForm>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public string slug { get; set; } = default!;
    [Parameter] public Guid eventId { get; set; }

    private Event? ev;
    private bool canEdit;
    private Guid currentUserId;
    private List<ShiftWithCount> shifts = new();

    [SupplyParameterFromForm(FormName = "shift-create")]
    private CreateInputModel? CreateInput { get; set; }

    [SupplyParameterFromForm]
    private ToggleInputModel? ToggleInput { get; set; }

    [SupplyParameterFromForm]
    private DeleteInputModel? DeleteInput { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CreateInput ??= new();
        ToggleInput ??= new();
        DeleteInput ??= new();

        var auth = await AuthState.GetAuthenticationStateAsync();
        var u = await UserManager.GetUserAsync(auth.User);
        if (u is null) { Navigation.NavigateTo("/Account/Login"); return; }
        currentUserId = u.Id;

        var band = await Db.Bands.FirstOrDefaultAsync(b => b.Slug == slug);
        if (band is null) { Navigation.NavigateTo("/Bands"); return; }

        var myMem = await Db.Memberships.FirstOrDefaultAsync(m => m.BandId == band.Id && m.UserId == currentUserId);
        if (myMem is null) { Navigation.NavigateTo("/Bands"); return; }
        canEdit = myMem.HasRole(BandRole.Admin) || myMem.HasRole(BandRole.Owner) || myMem.HasRole(BandRole.Dirigent);

        ev = await Db.Events.FirstOrDefaultAsync(e => e.Id == eventId && e.BandId == band.Id);
        if (ev is null) { Navigation.NavigateTo($"/Bands/{slug}/events"); return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        shifts = await ShiftService.GetForEventAsync(eventId, currentUserId);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(CreateInput?.Title)) return;
        var start = (CreateInput.Start ?? ev!.StartUtc.LocalDateTime).ToUniversalTime();
        var end = (CreateInput.End ?? ev!.EndUtc.LocalDateTime).ToUniversalTime();
        await ShiftService.CreateAsync(eventId, CreateInput.Title, start, end, CreateInput.RequiredCount);
        CreateInput.Title = "";
        await LoadAsync();
    }

    private async Task ToggleAsync()
    {
        if (ToggleInput?.ShiftId is null) return;
        await ShiftService.ToggleAssignAsync(ToggleInput.ShiftId.Value, currentUserId);
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (DeleteInput?.ShiftId is null) return;
        await ShiftService.DeleteAsync(DeleteInput.ShiftId.Value);
        await LoadAsync();
    }

    private sealed class CreateInputModel
    {
        public string Title { get; set; } = "";
        public DateTime? Start { get; set; }
        public DateTime? End { get; set; }
        public int RequiredCount { get; set; } = 2;
    }
    private sealed class ToggleInputModel { public Guid? ShiftId { get; set; } }
    private sealed class DeleteInputModel { public Guid? ShiftId { get; set; } }
}
